{
	"info": {
		"_postman_id": "c1f7b9e2-3489-4d2b-91c6-a3d8f8a29b41",
		"name": "Koodal Matrimony - Forgot & Reset Password Flow",
		"description": "Complete collection for testing the Forgot Password, OTP verification, Password Reset, and Login flows for Koodal Matrimony API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Request Reset OTP (Forgot Password)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"identifier\": \"{{mobile}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/forgot-password",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"forgot-password"
					]
				},
				"description": "Sends an OTP to the user's registered mobile number or email. Supports fields: `identifier`, `mobile`, or `phone`."
			},
			"response": []
		},
		{
			"name": "1b. Request Reset OTP (Using 'mobile' field)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"mobile\": \"{{mobile}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/forgot-password",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"forgot-password"
					]
				},
				"description": "Alternative payload using 'mobile' instead of 'identifier' as often used in mobile apps."
			},
			"response": []
		},
		{
			"name": "2. Verify OTP (Mobile App Step)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"mobile\": \"{{mobile}}\",\n    \"otp\": \"{{otp_code}}\",\n    \"purpose\": \"password_reset\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/verify-otp",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"verify-otp"
					]
				},
				"description": "Verifies the reset code entered by the user in the mobile app. Supports `code` or `otp`."
			},
			"response": []
		},
		{
			"name": "3. Resend OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"identifier\": \"{{mobile}}\",\n    \"purpose\": \"password_reset\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/resend-otp",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"resend-otp"
					]
				},
				"description": "Resends OTP to the user if they didn't receive it."
			},
			"response": []
		},
		{
			"name": "4. Reset Password (Phone as Password / Simple Password)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"mobile\": \"{{mobile}}\",\n    \"otp\": \"{{otp_code}}\",\n    \"password\": \"{{new_password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/reset-password",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"reset-password"
					]
				},
				"description": "Sets the new password. Supports `mobile` / `identifier`, `otp` / `code`, `password` / `new_password`. Confirmation field is optional and auto-handled if omitted."
			},
			"response": []
		},
		{
			"name": "4b. Reset Password (With Confirmation field)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"identifier\": \"{{mobile}}\",\n    \"code\": \"{{otp_code}}\",\n    \"password\": \"{{new_password}}\",\n    \"password_confirmation\": \"{{new_password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/reset-password",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"reset-password"
					]
				},
				"description": "Full standard payload with password_confirmation."
			},
			"response": []
		},
		{
			"name": "5. Login with New Password",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"identifier\": \"{{mobile}}\",\n    \"password\": \"{{new_password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				},
				"description": "Logs in with the newly reset password to verify that the credentials work."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "mobile",
			"value": "9876543210",
			"type": "string"
		},
		{
			"key": "otp_code",
			"value": "123456",
			"type": "string"
		},
		{
			"key": "new_password",
			"value": "9876543210",
			"type": "string"
		}
	]
}
