APP_NAME=Matrimony
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

# Origins allowed by CORS and used when building links in mail/notifications.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matrimony
DB_USERNAME=matrimony
DB_PASSWORD=

# utf8mb4 is required — profile text carries Indic scripts and emoji.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Stateful domains only matter for the SPA cookie flow; the mobile app uses
# bearer tokens exclusively.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174
SESSION_DOMAIN=localhost
TOKEN_EXPIRY_DAYS=30

# ---------------------------------------------------------------------------
# Storage — public disk serves photos, private disk holds documents
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=matrimony-public
AWS_PRIVATE_BUCKET=matrimony-private
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
CDN_URL=

# ---------------------------------------------------------------------------
# Razorpay — the secret must never reach a client bundle or the Flutter binary
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ---------------------------------------------------------------------------
# Firebase (FCM push, optional realtime chat transport)
# ---------------------------------------------------------------------------
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
# log = write the payload to the log instead of calling Google (local dev)
FCM_DRIVER=fcm

# ---------------------------------------------------------------------------
# Chat transport: reverb | firebase
# ---------------------------------------------------------------------------
CHAT_TRANSPORT=reverb
CHAT_REQUIRES=mutual_interest

REVERB_APP_ID=matrimony
REVERB_APP_KEY=matrimony-key
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ---------------------------------------------------------------------------
# Mail & SMS
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@matrimony.test"
MAIL_FROM_NAME="${APP_NAME}"

# log = print the OTP to the log instead of sending an SMS (local dev)
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=MATRMY
SMS_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Product toggles
# ---------------------------------------------------------------------------
OTP_REQUIRED=true
PROFILE_APPROVAL_REQUIRED=true
PHOTO_MODERATION_REQUIRED=true
MIN_APP_BUILD_ANDROID=1
MIN_APP_BUILD_IOS=1
