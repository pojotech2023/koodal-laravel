# Origins allowed by CORS and used when building links in mail/notifications.
FRONTEND_URL=https://koodalmatrimony.com
ADMIN_URL=https://koodalmatrimony.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
